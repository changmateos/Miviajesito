# Credenciales para Mi Viajecito App
# Copia este archivo como .env.local y completa tus claves reales.
# La app incluye un modo demo local que funciona incluso si no configuras estas claves inmediatamente.

# Supabase (Capa gratuita en https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here (opcional para scripts de backend)

# Google Gemini API Key (Capa gratuita en https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key-here
